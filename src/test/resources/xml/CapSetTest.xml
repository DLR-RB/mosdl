<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<mal:specification xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mal="http://www.ccsds.org/schema/ServiceSchema-v003">
    <mal:area number="4711" name="test" version="1">
        <mal:service name="ServiceName" number="1">
            <mal:capabilitySet number="7" comment="Basic operations for just getting definitions.">
                <mal:requestIP name="listDefinitions" number="1">
                    <mal:messages>
                        <mal:request/>
                        <mal:response>
                            <mal:field name="definitionIds" canBeNull="false">
<mal:type list="true" area="MAL" name="Identifier"/>
                            </mal:field>
                        </mal:response>
                    </mal:messages>
                </mal:requestIP>
                <mal:requestIP name="getDefinition" number="2">
                    <mal:messages>
                        <mal:request>
                            <mal:field name="definitionId" canBeNull="false">
<mal:type area="MAL" name="Identifier"/>
                            </mal:field>
                        </mal:request>
                        <mal:response>
                            <mal:field name="definition" canBeNull="false">
<mal:type area="MAL" name="Element"/>
                            </mal:field>
                        </mal:response>
                    </mal:messages>
                </mal:requestIP>
            </mal:capabilitySet>
            <mal:capabilitySet number="8" comment="Advanced operation to store new definitions.">
                <mal:submitIP name="addDefinition" number="3">
                    <mal:messages>
                        <mal:submit>
                            <mal:field name="definitionId" canBeNull="false">
<mal:type area="MAL" name="Identifier"/>
                            </mal:field>
                            <mal:field name="newDefinition" canBeNull="false">
<mal:type area="MAL" name="Element"/>
                            </mal:field>
                        </mal:submit>
                    </mal:messages>
                </mal:submitIP>
            </mal:capabilitySet>
        </mal:service>
    </mal:area>
</mal:specification>
