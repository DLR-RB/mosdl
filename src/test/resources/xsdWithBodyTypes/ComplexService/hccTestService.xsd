        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="monitorValueChanges_PUBSUB_PUBLISH_Body">
        <xs:complexContent>
            <xs:restriction base="malxml:Body">
                <xs:sequence>
                    <xs:element ref="malxml:UpdateHeaderList"/>
                    <xs:element nillable="true" ref="malxml:AttributeList"/>
