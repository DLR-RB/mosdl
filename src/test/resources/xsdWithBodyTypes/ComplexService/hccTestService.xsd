                </xs:sequence>
            </xs:restriction>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="monitorValueChanges_PUBSUB_NOTIFY_Body">
        <xs:complexContent>
            <xs:restriction base="malxml:Body">
                <xs:sequence>
                    <xs:element ref="malxml:Identifier"/>
                    <xs:element ref="malxml:UpdateHeaderList"/>
                    <xs:element nillable="true" ref="malxml:AttributeList"/>
                    <xs:element nillable="true" ref="malxml:AttributeList"/>
                </xs:sequence>
            </xs:restriction>
        </xs:complexContent>
    </xs:complexType>
</xs:schema>
